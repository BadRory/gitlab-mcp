aws_region  = "ap-southeast-2"
environment = "prod"

# Existing VPC — must have private subnets with routes to:
#   - GitLab (via VPC peering, TGW, or direct routing)
#   - AWS service endpoints (ECR, Secrets Manager, CloudWatch) via VPC endpoints or NAT
vpc_id             = "vpc-0123456789abcdef0"
private_subnet_ids = ["subnet-aaa111", "subnet-bbb222"]

# Self-hosted GitLab (must be reachable from the private subnets above)
gitlab_url     = "https://gitlab.corp.com"
gitlab_api_url = "https://gitlab.corp.com/api/v4"

# Cloudflare hostname that fronts the internal ALB via Direct Connect
mcp_server_url = "https://mcp.corp.com"

# ACM certificate covering mcp.corp.com (in the same region as the ALB)
certificate_arn = "arn:aws:acm:ap-southeast-2:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# CIDRs allowed to hit the internal ALB on port 443.
# Include:
#   - Your Direct Connect customer gateway CIDRs
#   - Cloudflare Anycast ranges (if using Cloudflare → Direct Connect path)
#     See: https://www.cloudflare.com/ips/
#   - VPC CIDR (for internal health checks)
allowed_ingress_cidrs = [
  "10.0.0.0/8",      # Example: on-prem via Direct Connect
  "172.16.0.0/12",   # Example: other VPCs via Transit Gateway
]

# Capacity — 2 tasks gives zero-downtime rolling deploys
desired_count = 2
task_cpu      = 512
task_memory   = 1024

# GitLab OAuth app credentials — populate after GitLab registration
# (or leave blank and update the secret in AWS Secrets Manager manually)
gitlab_oauth_app_id     = ""
gitlab_oauth_app_secret = ""
